<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ricardo | Técnico en Sistemas & Creador Digital</title>
    <style>
        :root {
            --bg: #050505;
            --surface: #0d0d0d;
            --surface-light: #1a1a1a;
            --text: #ffffff;
            --text-secondary: #aaaaaa;
            --text-muted: #666666;
            --border: #2a2a2a;
            --border-light: #3a3a3a;
            --glow: rgba(255, 255, 255, 0.2);
            --shadow-deep: 0 40px 80px rgba(0, 0, 0, 0.7);
            --transition: 0.35s cubic-bezier(0.4, 0, 0.2, 1);
            --radius: 16px;
            --sidebar-width: 230px;
            --font-sans: 'Inter', 'Segoe UI', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Arial, sans-serif;
            --font-mono: 'JetBrains Mono', 'Fira Code', 'Courier New', monospace;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
            scroll-padding-top: 0;
        }

        body {
            font-family: var(--font-sans);
            background: var(--bg);
            color: var(--text);
            line-height: 1.6;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            cursor: none;
        }

        /* ===== CURSOR PERSONALIZADO ===== */
        .cursor-dot {
            position: fixed;
            width: 8px;
            height: 8px;
            background: #ffffff;
            border-radius: 50%;
            pointer-events: none;
            z-index: 9999;
            mix-blend-mode: difference;
            transition: transform 0.1s ease;
            will-change: transform;
        }

        .cursor-dot.cursor-grow {
            transform: scale(2.5);
            background: rgba(255, 255, 255, 0.8);
        }

        /* ===== CANVAS DE PARTÍCULAS ===== */
        #particleCanvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 0;
            opacity: 0.6;
        }

        /* ===== SIDEBAR (PARALLAX) ===== */
        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            width: var(--sidebar-width);
            height: 100vh;
            background: rgba(13, 13, 13, 0.95);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 2rem 0;
            z-index: 1000;
            transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            backdrop-filter: blur(20px);
            will-change: transform;
            box-shadow: 4px 0 30px rgba(0, 0, 0, 0.3);
        }

        .sidebar-logo {
            text-align: center;
            margin-bottom: 3rem;
            position: relative;
        }

        .sidebar-logo .logo-name {
            font-size: 1.8rem;
            font-weight: 800;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            background: linear-gradient(135deg, #ffffff 0%, #aaaaaa 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            filter: drop-shadow(0 0 20px rgba(255, 255, 255, 0.4));
        }

        .sidebar-logo .logo-sub {
            font-size: 0.65rem;
            color: var(--text-muted);
            letter-spacing: 0.15em;
            text-transform: uppercase;
            font-weight: 400;
            margin-top: 4px;
        }

        .sidebar-nav {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            width: 100%;
            padding: 0 1rem;
            flex: 1;
        }

        .nav-btn {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 0.85rem 1.2rem;
            background: transparent;
            border: 1px solid transparent;
            border-radius: var(--radius);
            color: var(--text-secondary);
            font-family: var(--font-sans);
            font-size: 0.85rem;
            font-weight: 500;
            letter-spacing: 0.02em;
            cursor: pointer;
            transition: all var(--transition);
            text-decoration: none;
            position: relative;
            overflow: hidden;
            white-space: nowrap;
        }

        .nav-btn .nav-icon {
            font-size: 1.1rem;
            width: 24px;
            text-align: center;
            flex-shrink: 0;
            opacity: 0.7;
            transition: opacity var(--transition);
        }

        .nav-btn:hover {
            background: var(--surface-light);
            color: var(--text);
            border-color: var(--border);
            transform: translateX(6px);
            box-shadow: 0 0 20px rgba(255, 255, 255, 0.05);
        }

        .nav-btn:hover .nav-icon {
            opacity: 1;
        }

        .nav-btn.active {
            background: var(--text);
            color: var(--bg);
            border-color: var(--text);
            transform: translateX(6px);
            font-weight: 600;
            box-shadow: 0 0 30px rgba(255, 255, 255, 0.2);
        }

        .nav-btn.active .nav-icon {
            opacity: 1;
            color: var(--bg);
        }

        .nav-btn .nav-indicator {
            position: absolute;
            right: 0;
            top: 50%;
            transform: translateY(-50%);
            width: 3px;
            height: 0;
            background: var(--text);
            border-radius: 2px;
            transition: height var(--transition);
        }

        .nav-btn.active .nav-indicator {
            height: 60%;
        }

        .sidebar-footer {
            padding: 1rem;
            text-align: center;
            font-size: 0.7rem;
            color: var(--text-muted);
            letter-spacing: 0.05em;
        }

        /* ===== MOBILE TOGGLE ===== */
        .mobile-toggle {
            display: none;
            position: fixed;
            top: 1rem;
            left: 1rem;
            z-index: 1100;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 8px;
            color: var(--text);
            padding: 0.6rem 0.8rem;
            cursor: pointer;
            font-size: 1.3rem;
            transition: all var(--transition);
        }

        .mobile-toggle:hover {
            background: var(--surface-light);
            border-color: var(--border-light);
        }

        .sidebar-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.7);
            z-index: 999;
            opacity: 0;
            transition: opacity 0.3s;
        }

        /* ===== MAIN CONTENT ===== */
        .main-content {
            margin-left: var(--sidebar-width);
            min-height: 100vh;
            position: relative;
            z-index: 1;
        }

        /* ===== SECTIONS ===== */
        .section {
            min-height: 100vh;
            padding: 5rem 4rem;
            display: flex;
            flex-direction: column;
            justify-content: center;
            position: relative;
            border-bottom: 1px solid var(--border);
            opacity: 0;
            transform: translateY(30px);
            transition: opacity 0.6s, transform 0.6s;
        }

        .section.visible {
            opacity: 1;
            transform: translateY(0);
        }

        .section-header {
            margin-bottom: 3rem;
        }

        .section-label {
            font-family: var(--font-mono);
            font-size: 0.75rem;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            color: var(--text-muted);
            margin-bottom: 0.5rem;
        }

        .section-title {
            font-size: 2.8rem;
            font-weight: 800;
            letter-spacing: -0.02em;
            line-height: 1.15;
            text-transform: uppercase;
            filter: drop-shadow(0 0 30px rgba(255, 255, 255, 0.2));
        }

        .section-title .highlight {
            color: var(--text-muted);
            font-weight: 400;
        }

        .section-divider {
            width: 60px;
            height: 3px;
            background: var(--text);
            border-radius: 2px;
            margin-top: 1rem;
            box-shadow: 0 0 20px rgba(255, 255, 255, 0.3);
        }

        /* ===== HERO SECTION ===== */
        #inicio {
            background: transparent;
            position: relative;
            overflow: hidden;
        }

        #inicio::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -30%;
            width: 600px;
            height: 600px;
            background: radial-gradient(circle, rgba(255, 255, 255, 0.05) 0%, transparent 70%);
            border-radius: 50%;
            pointer-events: none;
        }

        #inicio::after {
            content: '';
            position: absolute;
            bottom: -20%;
            left: -10%;
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, rgba(255, 255, 255, 0.03) 0%, transparent 70%);
            border-radius: 50%;
            pointer-events: none;
        }

        .hero-content {
            position: relative;
            z-index: 1;
            max-width: 800px;
        }

        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--border);
            border-radius: 50px;
            padding: 0.5rem 1.2rem;
            font-size: 0.75rem;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--text-secondary);
            margin-bottom: 2rem;
            backdrop-filter: blur(10px);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
        }

        .hero-badge .dot {
            width: 6px;
            height: 6px;
            background: #ffffff;
            border-radius: 50%;
            animation: pulse-dot 2s infinite;
        }

        @keyframes pulse-dot {
            0%,
            100% {
                opacity: 1;
                transform: scale(1);
                box-shadow: 0 0 10px rgba(255, 255, 255, 0.8);
            }
            50% {
                opacity: 0.3;
                transform: scale(1.5);
                box-shadow: 0 0 20px rgba(255, 255, 255, 0.4);
            }
        }

        .hero-title {
            font-size: 4.5rem;
            font-weight: 900;
            letter-spacing: -0.03em;
            line-height: 1.05;
            text-transform: uppercase;
            margin-bottom: 1.5rem;
            filter: drop-shadow(0 0 40px rgba(255, 255, 255, 0.3));
        }

        .hero-title .outline {
            color: transparent;
            -webkit-text-stroke: 1.5px var(--text);
        }

        .hero-subtitle {
            font-size: 1.15rem;
            color: var(--text-secondary);
            max-width: 600px;
            margin-bottom: 2.5rem;
            font-weight: 300;
            letter-spacing: 0.01em;
        }

        .hero-cta {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 0.9rem 2rem;
            border-radius: 50px;
            font-family: var(--font-sans);
            font-size: 0.9rem;
            font-weight: 600;
            letter-spacing: 0.03em;
            cursor: pointer;
            text-decoration: none;
            transition: all var(--transition);
            border: 1px solid transparent;
            position: relative;
            overflow: hidden;
        }

        .btn::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 0;
            height: 0;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.1);
            transition: width 0.4s, height 0.4s, top 0.4s, left 0.4s;
        }

        .btn:hover::after {
            width: 300px;
            height: 300px;
            top: -100px;
            left: -100px;
        }

        .btn-primary {
            background: var(--text);
            color: var(--bg);
            border-color: var(--text);
            box-shadow: 0 0 30px rgba(255, 255, 255, 0.4);
        }

        .btn-primary:hover {
            background: transparent;
            color: var(--text);
            border-color: var(--text);
            transform: translateY(-2px);
            box-shadow: 0 0 50px rgba(255, 255, 255, 0.6);
        }

        .btn-outline {
            background: transparent;
            color: var(--text);
            border-color: var(--border-light);
        }

        .btn-outline:hover {
            background: var(--surface-light);
            border-color: var(--text);
            transform: translateY(-2px);
            box-shadow: 0 0 30px rgba(255, 255, 255, 0.2);
        }

        .btn .btn-arrow {
            transition: transform var(--transition);
        }
        .btn:hover .btn-arrow {
            transform: translateX(4px);
        }

        .hero-stats {
            display: flex;
            gap: 3rem;
            margin-top: 3rem;
            padding-top: 2rem;
            border-top: 1px solid var(--border);
        }

        .hero-stat .stat-number {
            font-size: 2rem;
            font-weight: 800;
            letter-spacing: -0.02em;
            text-shadow: 0 0 20px rgba(255, 255, 255, 0.5);
        }

        .hero-stat .stat-label {
            font-size: 0.75rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.1em;
            font-weight: 400;
        }

        /* ===== SERVICES SECTION (3D) ===== */
        #servicios {
            background: transparent;
        }

        .services-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 2rem;
            perspective: 1200px;
        }

        .service-card {
            background: linear-gradient(145deg, #1e1e1e 0%, #0a0a0a 100%);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 2rem 1.5rem;
            transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.4s, border-color 0.4s, background 0.4s;
            cursor: default;
            position: relative;
            overflow: hidden;
            transform-style: preserve-3d;
            transform: rotateX(0deg) rotateY(0deg) translateZ(0);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
            will-change: transform;
            opacity: 0;
            transform: translateY(40px) scale(0.95);
            transition: opacity 0.5s, transform 0.5s, box-shadow 0.4s, border-color 0.4s;
        }

        .service-card.visible {
            opacity: 1;
            transform: translateY(0) scale(1);
        }

        .service-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 2px;
            background: var(--text);
            transform: scaleX(0);
            transform-origin: left;
            transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 0 20px rgba(255, 255, 255, 0.5);
        }

        .service-card::after {
            content: '';
            position: absolute;
            bottom: 15px;
            left: 10%;
            right: 10%;
            height: 30px;
            background: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.7) 0%, transparent 70%);
            filter: blur(8px);
            z-index: -1;
            transition: all 0.4s;
        }

        .service-card:hover {
            border-color: var(--border-light);
            transform: rotateX(10deg) rotateY(-10deg) translateY(-12px) translateZ(30px);
            box-shadow: 0 40px 80px rgba(0, 0, 0, 0.8), 0 0 40px rgba(255, 255, 255, 0.15);
            background: linear-gradient(145deg, #222222 0%, #0d0d0d 100%);
        }

        .service-card:hover::before {
            transform: scaleX(1);
        }

        .service-card:hover::after {
            bottom: 5px;
            filter: blur(12px);
            background: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.9) 0%, transparent 70%);
        }

        .service-icon {
            font-size: 2.2rem;
            margin-bottom: 1rem;
            display: block;
            transform: translateZ(30px);
            filter: drop-shadow(0 0 15px rgba(255, 255, 255, 0.4));
        }

        .service-card h3 {
            font-size: 1.1rem;
            font-weight: 700;
            margin-bottom: 0.75rem;
            letter-spacing: 0.01em;
            transform: translateZ(20px);
        }

        .service-card p {
            font-size: 0.85rem;
            color: var(--text-secondary);
            line-height: 1.7;
            font-weight: 300;
            transform: translateZ(15px);
        }

        .service-tag {
            display: inline-block;
            margin-top: 1rem;
            font-family: var(--font-mono);
            font-size: 0.65rem;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--text-muted);
            background: rgba(255, 255, 255, 0.05);
            padding: 0.3rem 0.7rem;
            border-radius: 4px;
            transform: translateZ(10px);
            backdrop-filter: blur(5px);
        }

        /* ===== PORTFOLIO SECTION (3D MEJORADO) ===== */
        #portafolio {
            background: transparent;
        }

        .portfolio-slider {
            position: relative;
            width: 100%;
            max-width: 1000px;
            margin: 0 auto;
            padding: 0 60px;
            perspective: 1500px;
        }

        .portfolio-viewport {
            overflow: hidden;
            width: 100%;
            border-radius: var(--radius);
        }

        .portfolio-track {
            display: flex;
            transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
            will-change: transform;
            transform-style: preserve-3d;
        }

        .portfolio-slide {
            flex: 0 0 100%;
            min-width: 0;
            padding: 0 10px;
            box-sizing: border-box;
            transform-style: preserve-3d;
        }

        .portfolio-card {
            background: linear-gradient(145deg, #1e1e1e 0%, #0a0a0a 100%);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 3rem 2rem;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 320px;
            transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.5s, border-color 0.5s;
            cursor: grab;
            position: relative;
            overflow: hidden;
            box-shadow: 0 30px 80px rgba(0, 0, 0, 0.8), 0 0 0 1px rgba(255, 255, 255, 0.05);
            transform-style: preserve-3d;
            transform: rotateX(0deg) rotateY(0deg) translateZ(0);
            animation: float 6s ease-in-out infinite;
            will-change: transform;
            opacity: 0;
            transition: opacity 0.5s, transform 0.5s, box-shadow 0.5s;
        }

        .portfolio-card.visible {
            opacity: 1;
        }

        .portfolio-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 60%;
            background: linear-gradient(to bottom, rgba(255, 255, 255, 0.08) 0%, transparent 100%);
            pointer-events: none;
            border-radius: var(--radius) var(--radius) 0 0;
        }

        .portfolio-card::after {
            content: '';
            position: absolute;
            bottom: 10px;
            left: 5%;
            right: 5%;
            height: 40px;
            background: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.8) 0%, transparent 70%);
            pointer-events: none;
            filter: blur(10px);
            z-index: -1;
            transition: all 0.5s;
        }

        .portfolio-card:hover {
            border-color: var(--border-light);
            transform: rotateX(12deg) rotateY(-12deg) translateY(-20px) translateZ(50px);
            box-shadow: 0 50px 120px rgba(0, 0, 0, 0.9), 0 0 60px rgba(255, 255, 255, 0.2);
        }

        .portfolio-card:hover::after {
            bottom: 0;
            filter: blur(15px);
            background: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.9) 0%, transparent 70%);
        }

        .portfolio-card:active {
            cursor: grabbing;
        }

        .portfolio-card .portfolio-icon {
            font-size: 4rem;
            margin-bottom: 1.5rem;
            opacity: 0.8;
            transition: all var(--transition);
            transform: translateZ(40px);
            filter: drop-shadow(0 0 25px rgba(255, 255, 255, 0.5));
        }

        .portfolio-card:hover .portfolio-icon {
            opacity: 1;
            transform: translateZ(60px) scale(1.1);
            filter: drop-shadow(0 0 40px rgba(255, 255, 255, 0.8));
        }

        .portfolio-card .portfolio-title {
            font-size: 1.5rem;
            font-weight: 700;
            letter-spacing: 0.02em;
            margin-bottom: 0.5rem;
            transform: translateZ(30px);
            text-shadow: 0 0 20px rgba(255, 255, 255, 0.3);
        }

        .portfolio-card .portfolio-category {
            font-size: 0.85rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.1em;
            font-family: var(--font-mono);
            transform: translateZ(20px);
        }

        /* Animación 3D al cambiar de slide */
        .portfolio-slide.is-animating .portfolio-card {
            animation: cardFloat3D 0.7s cubic-bezier(0.4, 0, 0.2, 1);
        }

        @keyframes cardFloat3D {
            0% {
                transform: rotateY(25deg) translateZ(-120px);
                opacity: 0.5;
            }
            50% {
                transform: rotateY(-10deg) translateZ(80px);
                opacity: 1;
            }
            100% {
                transform: rotateY(0deg) translateZ(0);
                opacity: 1;
            }
        }

        @keyframes float {
            0% {
                transform: translateY(0px);
            }
            50% {
                transform: translateY(-12px);
            }
            100% {
                transform: translateY(0px);
            }
        }

        .portfolio-arrow {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            width: 52px;
            height: 52px;
            border-radius: 50%;
            background: rgba(13, 13, 13, 0.9);
            border: 1px solid var(--border);
            color: var(--text);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all var(--transition);
            z-index: 10;
            font-size: 1.2rem;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(10px);
        }

        .portfolio-arrow:hover {
            background: var(--text);
            color: var(--bg);
            border-color: var(--text);
            box-shadow: 0 0 40px rgba(255, 255, 255, 0.4);
            transform: translateY(-50%) scale(1.1);
        }

        .portfolio-arrow.prev {
            left: 0;
        }

        .portfolio-arrow.next {
            right: 0;
        }

        .portfolio-dots {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-top: 1.5rem;
        }

        .portfolio-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--border-light);
            border: none;
            cursor: pointer;
            transition: all var(--transition);
            padding: 0;
        }

        .portfolio-dot.active {
            background: var(--text);
            transform: scale(1.3);
            box-shadow: 0 0 20px rgba(255, 255, 255, 0.5);
        }

        .portfolio-dot:hover {
            background: var(--text-muted);
        }

        /* ===== ABOUT SECTION ===== */
        #sobre-mi {
            background: transparent;
        }

        .about-content {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 3rem;
            align-items: start;
        }

        .about-text p {
            font-size: 1rem;
            color: var(--text-secondary);
            margin-bottom: 1.2rem;
